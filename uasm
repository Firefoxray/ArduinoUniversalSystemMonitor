#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="${UASM_REPO_DIR:-$SCRIPT_DIR}"
RUNTIME_SCRIPT="$REPO_DIR/UniversalArduinoMonitor.py"

if [[ ! -f "$RUNTIME_SCRIPT" ]]; then
  echo "Unable to locate UniversalArduinoMonitor.py."
  echo "Expected at: $RUNTIME_SCRIPT"
  echo "Set UASM_REPO_DIR to your repo path or reinstall with install.sh."
  exit 2
fi

if [[ "$#" -eq 0 ]]; then
  echo "Use 'uasm help' for a command list."
  exec python3 "$RUNTIME_SCRIPT" help
fi
if [[ "${1:-}" == "help" ]]; then
  exec python3 "$RUNTIME_SCRIPT" help
fi
exec python3 "$RUNTIME_SCRIPT" "$@"
