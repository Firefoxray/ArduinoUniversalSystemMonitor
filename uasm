#!/usr/bin/env bash
set -Eeuo pipefail

# Resolve this launcher through symlinks so ~/.local/bin/uasm can safely point
# back to the repository copy on every machine.
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_SOURCE")"
  if [[ "$LINK_TARGET" = /* ]]; then
    SCRIPT_SOURCE="$LINK_TARGET"
  else
    SCRIPT_SOURCE="$SOURCE_DIR/$LINK_TARGET"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
REPO_DIR="${UASM_REPO_DIR:-$SCRIPT_DIR}"
RUNTIME_SCRIPT="$REPO_DIR/UniversalArduinoMonitor.py"

if [[ ! -f "$RUNTIME_SCRIPT" ]]; then
  echo "Unable to locate UniversalArduinoMonitor.py."
  echo "Expected at: $RUNTIME_SCRIPT"
  echo "Set UASM_REPO_DIR to your repo path or reinstall with install.sh."
  exit 2
fi

# Keep the historical launcher names as lightweight aliases to one canonical
# implementation. The invoked basename is preserved even when this file is
# reached through a symlink.
case "$(basename "$0")" in
  uasm-fetch|uasmfetch|rayfetch)
    set -- fetch "$@"
    ;;
  uasm-update)
    set -- update "$@"
    ;;
esac

if [[ "$#" -eq 0 ]]; then
  echo "Use 'uasm help' for a command list."
  set -- help
fi

# Repair must work before importing the runtime, even after a Python upgrade.
if [[ "$1" == update || "$1" == --update ]]; then
  if [[ "$#" -ne 1 ]]; then
    echo "Usage: uasm update" >&2
    exit 2
  fi
  exec bash "$REPO_DIR/scripts/update.sh"
fi

# Match the systemd service interpreter, not an activated virtual environment.
if ! /usr/bin/python3 -c 'import psutil, serial' >/dev/null 2>&1; then
  echo "UASM runtime dependencies missing or broken in /usr/bin/python3." >&2
  if [[ "$1" == doctor ]]; then
    /usr/bin/python3 -c 'import psutil' >/dev/null 2>&1 && echo "[OK] psutil" || echo "[FAIL] psutil"
    /usr/bin/python3 -c 'import serial' >/dev/null 2>&1 && echo "[OK] pyserial" || echo "[FAIL] pyserial"
  fi
  echo "Run 'uasm update' from the stable main checkout to repair dependencies." >&2
  exit 1
fi

exec /usr/bin/python3 "$RUNTIME_SCRIPT" "$@"
