#!/usr/bin/env bash
set -Eeuo pipefail

# Resolve this launcher through symlinks so ~/.local/bin/uasm can safely point
# back to the repository copy on every machine.
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_SOURCE")"
  if [[ "$LINK_TARGET" = /* ]]; then
    SCRIPT_SOURCE="$LINK_TARGET"
  else
    SCRIPT_SOURCE="$SOURCE_DIR/$LINK_TARGET"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
REPO_DIR="${UASM_REPO_DIR:-$SCRIPT_DIR}"
RUNTIME_SCRIPT="$REPO_DIR/UniversalArduinoMonitor.py"

if [[ ! -f "$RUNTIME_SCRIPT" ]]; then
  echo "Unable to locate UniversalArduinoMonitor.py."
  echo "Expected at: $RUNTIME_SCRIPT"
  echo "Set UASM_REPO_DIR to your repo path or reinstall with install.sh."
  exit 2
fi

# Keep the historical launcher names as lightweight aliases to one canonical
# implementation. The invoked basename is preserved even when this file is
# reached through a symlink.
case "$(basename "$0")" in
  uasm-fetch|uasmfetch|rayfetch)
    set -- fetch "$@"
    ;;
  uasm-update)
    set -- update "$@"
    ;;
esac

if [[ "$#" -eq 0 ]]; then
  echo "Use 'uasm help' for a command list."
  set -- help
fi

exec /usr/bin/env python3 "$RUNTIME_SCRIPT" "$@"
